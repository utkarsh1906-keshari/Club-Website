# =========================================================
# Drone & Robotics Club - Environment Configuration Example
# Copy this file to .env and fill in your actual credentials
# =========================================================

# Supabase Backend Configuration
# Find these in your Supabase project dashboard: Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Application Settings
VITE_APP_TITLE="Drone & Robotics Club"
VITE_APP_DESCRIPTION="Official website for Drone & Robotics Club - ABES Engineering College"
VITE_APP_URL=http://localhost:5173
VITE_CONTACT_EMAIL=contact@droneandrobotics.club

# Admin Control Center Authorization Passkeys (Set in Vercel / Production)
VITE_FACULTY_PASSKEY=Faculty@ABES2026
VITE_CLUBHEAD_PASSKEY=ClubHead@ABES2026
VITE_ADMIN_MASTER_KEY=ABES#DRC2026
